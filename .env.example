# Shared Mongo (same cluster as the admin and the website)
MONGODB_URI=mongodb://localhost:27017
LESSONS_DB_NAME=ldco-lessons
BLD_DB_NAME=bld
MAIN_DB_NAME=ldco
# Whose classes get posted (ldco.instructors _id)
INSTRUCTOR_ID=
DEFAULT_TIME_ZONE=America/Denver

# Facebook Page (see README: "Facebook setup")
# Only needed by scripts/fb-page-token.ts
FB_APP_ID=
FB_APP_SECRET=
FB_PAGE_ID=
FB_PAGE_TOKEN=
FB_GRAPH_VERSION=v25.0
# Nothing reaches Facebook unless this is exactly "live"; anything else is a dry run.
FACEBOOK_PUBLISH=dry-run

# Phone alerts: set Pushover OR ntfy (Pushover wins if both are set)
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=

# Links
SITE_URL=https://beyondlinedance.com
ADMIN_URL=https://admin.example.com

# Vercel sends "Authorization: Bearer $CRON_SECRET" to the cron route
CRON_SECRET=
# Shared with line-dance-manager-admin so "Approve" can publish right away
INTERNAL_API_SECRET=
